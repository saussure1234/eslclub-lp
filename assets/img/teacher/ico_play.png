op:calc(var(--_space, 1.8rem) * 1.25 * var(--_margin-scale, 1))}.blog-cta-block{.blog-cta-heading{font-size:1.34em;display:inline;background:linear-gradient(transparent 66%,#ffde59 66%);font-weight:700}.blog-cta-editor{margin-top:calc(var(--_space, 1.8rem) * .5 * var(--_margin-scale, 1));&>*+*{margin-top:1em}font-size:14px;line-height:1.6;}.blog-cta-buttons{margin-top:calc(var(--_space, 1.8rem) * .8 * var(--_margin-scale, 1));.blog-cta-btn+a{margin-top:8px}.blog-cta-btn{max-width:80%;margin-inline:auto;display:flex;justify-content:center;align-items:center;color:#fff;font-weight:bold;font-size:1.125em;line-height:1.3;padding:.75em 2.5em .6em 1.5em;border-radius:3px;text-decoration:none;position:relative;&:after{content:'';width:.6em;height:.6em;border:#fff solid;border-width:2px 2px 0 0;transform:rotate(45deg);position:absolute;top:50%;right:1.25em;margin-top:-.3em;display:block}}}}}@media (max-width:749px){.blog-cta-area{padding-inline:.5em;.blog-cta-block{.blog-cta-heading{font-size:1.125em}.blog-cta-buttons{margin-top:calc(var(--_space, 1.8rem) * .75 * var(--_margin-scale, 1));.blog-cta-btn{max-width:100%;font-size:1em;padding:.875em 2em .75em 1.25em;letter-spacing:0;&:after{right:1em}}}}}}table.form input,table.form textarea,table.form select{line-height:calc(1 + var(--_half-leading, .4) * 2)}.online_2_head picture{text-align:center;img{display:inline}}.new_kv .main_catch{font-weight:700}.blog_cta_box{picture{display:block;text-align:center;img{width:645px;display:inline}}ul{margin:1.5em 0 0;padding:0;list-style:none}li{margin-top:.5em}}.l-contents__inner{&>.l-contents__main:not(:only-child){flex-basis:46rem;&+.l-contents__sidebar{flex-basis:336px}}}</style><meta name="google-site-verification" content="YkYKlOJ1rN0gip38XNKBG4unbzEbXRvDupC2_49RQf8" /></head><body class="lp_index home "> <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TNXQD5T" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript><div id="page_top" class="wrapper  "><header class="page_header"><nav class="header_nav"><p class="header_logo"><a href="https://eslclub.jp"><img class="pc" src="/assets/img/index_lp/logo.svg" alt="ESL club"><img class="sp" src="/assets/img/index_lp/logo_s.svg" alt="ESL club"></a></p><ul class="header_text_nav_list"><li><a href="#service"><span class="tx">サービス内容</span></a></li><li><button class="add_menu"><span class="tx">料金</span></button><ul><li><button data-section="shibuya" class="school_tab_item_price">渋谷校</button></li><li><button data-section="online" class="school_tab_item_price">オンライン校</button></li></ul></li><li><a href="#shibuya" class="school_tab_item" data-tab="0"><span class="tx">渋谷校</span></a></li><li><a href="#online" class="school_tab_item" data-tab="1"><span class="tx">オンライン校</span></a></li></ul><ul class="header_nav_list"><li class="i-lesson"><a href="https://eslclub.jp/trial/"> <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="20.202" height="13.506" viewBox="0 0 20.202 13.506"><g transform="translate(-761.151 -1325.052)"><path d="M27.715,20.88a.406.406,0,0,1-.19-.04l-9.6-4.03a.5.5,0,0,1,0-.92l9.6-4.04a.445.445,0,0,1,.39,0l9.6,4.04a.5.5,0,0,1,0,.92l-9.6,4.03a.477.477,0,0,1-.2.04M19.4,16.35l8.311,3.49,8.311-3.49-8.311-3.5Z" transform="translate(743.537 1313.248)" fill="#0a0a0a"/><path d="M18.208,17.778a.5.5,0,0,1-.5-.5v-4.5a.5.5,0,1,1,1,0v4.5a.5.5,0,0,1-.5.5" transform="translate(744.383 1317.51)" fill="#0a0a0a"/><path d="M18.576,18a.51.51,0,0,1-.51-.5v-4.58a.505.505,0,0,1,1.01,0V17.5a.508.508,0,0,1-.5.5" transform="translate(747.605 1318.815)" fill="#0a0a0a"/><path d="M19.569,18.113a.5.5,0,0,1-.5-.5v-4.7a.5.5,0,0,1,1,0v4.7a.5.5,0,0,1-.5.5" transform="translate(756.633 1318.815)" fill="#0a0a0a"/><path d="M23.92,15.666c-2.36,0-5.85-.73-5.85-2.29a.5.5,0,0,1,1,0c0,.39,2.05,1.29,4.85,1.29,2.69,0,4.15-.85,4.15-1.29a.5.5,0,0,1,.5-.5.5.5,0,0,1,.5.5c0,1.5-2.59,2.29-5.15,2.29" transform="translate(747.641 1322.892)" fill="#0a0a0a"/></g></svg></span> <span class="tx"><span>無料体験レッスンに</span><span>申し込む</span></span> </a></li><li class="i-lesson02 pc"><a href="https://eslclub.jp/highschool/"> <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="512" height="359.05" viewBox="0 0 512 359.05"><g transform="translate(0 -76.475)"><path d="M373.366,195.429,256,76.475,138.635,195.429H0v240.1H512v-240.1ZM23.746,219.175H148.56L256,110.285l107.445,108.89H488.254v192.6H281.427v-78.31a25.431,25.431,0,0,0-50.862,0v78.31H23.746Z" fill="#fff"/><rect width="26.45" height="48.822" transform="translate(62.164 314.005)" fill="#fff"/><rect width="26.452" height="48.822" transform="translate(144.672 314.005)" fill="#fff"/><rect width="26.451" height="48.822" transform="translate(340.87 314.005)" fill="#fff"/><rect width="26.452" height="48.822" transform="translate(423.386 314.005)" fill="#fff"/><path d="M256,258.829a49.51,49.51,0,1,0-49.51-49.51A49.519,49.519,0,0,0,256,258.829ZM232.18,185.5a33.684,33.684,0,1,1-9.863,23.823A33.581,33.581,0,0,1,232.18,185.5Z" fill="#fff"/><path d="M275.406,205.362H259.954V186.046h-7.916v27.232h23.368Z" fill="#fff"/></g></svg></span> <span class="tx"><span>中高生はこちら</span></span> </a></li></ul></nav></header><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.min.css"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.css"><article class="page_contents"><div class="kv_type_c" style="width: 100%; margin: 0;"><div class="story_head"><h1 class="story_main_catch v2 js-ani"> <span><span class="ib">小学生で</span><span class="ib">英検2級レベルを</span></span> <span><strong class="ib">世界で活躍する</strong><strong class="ib">英語力を身に付ける</strong><strong class="ib">ESL club</strong></span></h1></div><ul class="slider"><li><img src="/assets/img/story/slide01.png"></li><li><img src="/assets/img/story/slide02.png"></li></ul></div><div class="cta_campaign_wrap"><div class="cta_campaign01 winter cta__no-separator"><div class="campaign_text"><p><strong><span class="cl ib">バイリンガル講師の</span><span class="cl ib">個別レッスン<span>が</span>受けられる！</span></strong></p></div></div><div class="cta_wrap"><div class="cta_btn"> <a href="https://eslclub.jp/trial/"> <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="44" height="48" viewBox="0 0 44 48"><g transform="translate(-1160.189 -7421.383)"><path d="M197.219,800.338a3.478,3.478,0,0,1-2.163-.783L176.54,783.528,158,799.555a3.308,3.308,0,0,1-4.679-.4,3.393,3.393,0,0,1,.353-4.723l20.7-17.841a3.225,3.225,0,0,1,4.3,0l20.7,17.841a3.393,3.393,0,0,1,.353,4.723,3.261,3.261,0,0,1-2.516,1.186" transform="translate(1960.528 7268.854) rotate(90)" fill="#fff"></path><path d="M197.219,799.654a3.375,3.375,0,0,1-2.163-.807l-18.516-16-18.539,16a3.265,3.265,0,0,1-4.679-.38,3.4,3.4,0,0,1,.353-4.724l20.7-17.862a3.276,3.276,0,0,1,4.3,0l20.7,17.862a3.394,3.394,0,0,1,.353,4.724,3.259,3.259,0,0,1-2.516,1.187" transform="translate(1979.265 7268.854) rotate(90)" fill="#fff"></path></g></svg></span> <span class="tx"><span>お子さまからの「通いたい！」が聞ける</span><span>無料体験レッスンに申し込む</span></span> </a></div></div></div><section class="story_first"><div class="view_block"><div class="l_box"><div class="text_box"><p> <span class="ib">ESL clubでは、小学生のうちに<u>英検2級レベルの英語力</u>と、海外留学挑戦などを通じて、学びを楽しむ力を育むことを目指しています。</span></p></div><figure class="image"> <img src="/assets/img/story/sec01_photo02.jpg" alt=""></figure></div></div></section><section id="service" class="story_service"><div class="story_service_head" style="margin-bottom: 0;"><p class="service_catch"><span>「小学生で英検2級」と「学びを楽しむ力」を同時に叶えられる3つの理由</span></p><ul class="service_list"><li class="service_point"> <a href="#service01"> <span class="point"> <span class="tx">POINT</span> <span class="no">1</span> </span><p><span>お子さまの​性格や</span><span>​好きなことを​元に</span><span>​担当講師陣を​アサイン</span></p> </a></li><li class="service_point cont_a"> <a href="#service02"> <span class="point"> <span class="tx">POINT</span> <span class="no">2</span> </span><p><span>海外経験豊富な</span><span>​バイリンガル講師との</span><span>​マンツーマンレッスン</span></p> </a></li><li class="service_point"> <a href="#service03"> <span class="point"> <span class="tx">POINT</span> <span class="no">3</span> </span><p><span>オーダーメイドの</span><span>カリキュラムと7歳から</span><span>一人で​できる​宿題設計</span></p> </a></li></ul></div><div class="story_service_detail" style="background: #fff;"><div id="service01" class="point_box"><div class="in_wrap"><h3 class="point_title_variation"> <span class="no">01</span> <span class="title"> <span class="ib">英語が​嫌いな​お子さまからも​「通いたい」が​聞ける​</span> </span> <span class="sub_title"> <span class="ib">お子さまの​性格や​好きなことを​元に​担当講師陣を​アサイン</span> </span></h3><div class="l_box reverse"><div class="text_box"><p class="row_text"> <span class="ib">子どもの性格や好きなことを元に担当講師をアサインするからレッスンが楽しみに。</span><br> <span class="ib">英語が嫌いなお子さまでも通いたくなるため、英語力を伸ばすために必要な「継続」する機会になります。</span></p></div><figure class="image"> <img src="/assets/img/story/point01_photo2.jpg" alt="" style="object-fit: cover;"></figure></div></div></div><div id="service02" class="point_box cont_a"><div class="in_wrap"><h3 class="point_title_variation"> <span class="no">02</span> <span class="title"> <span class="ib">相談しやすく​失敗を​怖がらずに話せる​雰囲気だから​どんどん​伸びる</span> </span> <span class="sub_title"> <span class="ib">海外経験豊富な​バイリンガル講師との​マンツーマンレッスン</span> </span></h3><div class="l_box"><div class="text_box"><p class="row_text"> <span class="ib">英検1級・TOEIC900点以上の確かな英語力と、分からないことを聞きたい時に日本語でも聞けるバイリンガル講師のみを採用。</span> <span class="ib">帰国子女の大学生が中心で、質問しやすさや失敗を怖がらずに話せる雰囲気を大事にしているため、相談しやすいから英語力がどんどん伸びて、失敗を恐れないマインドが身に付いていきます。</span></p></div><figure class="image"> <img src="/assets/img/story/point01_photo.jpg" alt="" style="object-fit: contain;"></figure></div></div></div><div id="service03" class="point_box"><div class="in_wrap"><h3 class="point_title_variation"> <span class="no">03</span> <span class="title"> <span class="ib">親が​勉強を​見る​ことができなくても​着実に​成長​</span> </span> <span class="sub_title"> <span class="ib">オーダーメイドのカリキュラムと7歳から一人でできる宿題設計</span> </span></h3><div class="l_box reverse"><div class="text_box"><p class="row_text"> <span class="ib">2015年の開塾以降、1,000名以上を英検合格に導いた英検ベースのカリキュラムを元に、お子さまの目標（例：小学5年生までに英検2級）と現在の英語レベルから一人一人に合わせて個別にカスタマイズ。</span><br> <span class="ib">レッスン間の​宿題を​一人で​できるように​設計している​ため、忙しい​親御さんでも​安心してお任せいただけます。</span></p></div><figure class="image"> <img src="/assets/img/story/point03_photo2.jpg" alt="" style="object-fit: contain;"></figure></div></div></div></div><div class="service_why"><h3 class="whi_title">英検を使う理由</h3><div class="l_box"><div class="text_box"><p class="row_text"> <span class="ib" style="font-weight: bold;font-size: 1.5rem;"> １．4技能に対応 </span><br> <span class="ib">1つ目は、英検が小学生にも取り組みやすい段階的なレベル設計になっていて、国際基準であるCEFRに対応した英語4技能試験の英検で学ぶことで、英語4技能をバランスよく伸ばせるためです。</span></p><p class="row_text"> <span class="ib" style="font-weight: bold;font-size: 1.5rem;"> ２．中学受験でのニーズ増加 </span><br> <span class="ib">2つ目は、中学受験で英語を評価・活用する学校が増え、英検が目標設定や実力証明として使われやすくなっているからです。</span></p><p class="row_text" style="border: 1px solid #000;padding: 1rem;"> <span class="ib" style="font-weight: bold;">中学受験合格実績​（一部）​</span><br> 三田国際科学学園中学校・​高等学校<br> 東京学芸大学附属国際中等教育学校<br> ​広尾学園中学校・​高等学校<br> 海城中学高等学校<br> 開智日本橋学園中学・高等学校<br> 学習院中等科<br> サレジアン国際学園中学校高等学校<br> トキワ松学園中学校高等学校<br> ドルトン東京学園 中等部・高等部​<br> 山脇学園中学校・​高等学校<br> 聖学院中学校・​高等学校<br> 聖セシリア女子中学校・​高等学校</p></div><figure class="image"> <img class="why_photo01" src="/assets/img/story/why_photo01.jpg" alt=""> <img class="why_photo02" src="/assets/img/story/why_photo02.jpg" alt=""></figure></div><div class="cta_campaign_wrap"><div class="cta_campaign01 winter cta__no-separator"><div class="campaign_text"><p><strong><span class="cl">バイリンガル講師<span>の</span></span><span class="cl">個別レッスン<span>が</span>受けられる！</span></strong></p></div></div><div class="cta_wrap"><div class="cta_btn"> <a href="https://eslclub.jp/trial/"> <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="44" height="48" viewBox="0 0 44 48"><g transform="translate(-1160.189 -7421.383)"><path d="M197.219,800.338a3.478,3.478,0,0,1-2.163-.783L176.54,783.528,158,799.555a3.308,3.308,0,0,1-4.679-.4,3.393,3.393,0,0,1,.353-4.723l20.7-17.841a3.225,3.225,0,0,1,4.3,0l20.7,17.841a3.393,3.393,0,0,1,.353,4.723,3.261,3.261,0,0,1-2.516,1.186" transform="translate(1960.528 7268.854) rotate(90)" fill="#fff"></path><path d="M197.219,799.654a3.375,3.375,0,0,1-2.163-.807l-18.516-16-18.539,16a3.265,3.265,0,0,1-4.679-.38,3.4,3.4,0,0,1,.353-4.724l20.7-17.862a3.276,3.276,0,0,1,4.3,0l20.7,17.862a3.394,3.394,0,0,1,.353,4.724,3.259,3.259,0,0,1-2.516,1.187" transform="translate(1979.265 7268.854) rotate(90)" fill="#fff"></path></g></svg></span> <span class="tx"><span>お子さまからの「通いたい！」が聞ける</span><span>無料体験レッスンに申し込む</span></span> </a></div></div></div></div></section> <a class="seasonalschool_bn" href="https://eslclub.jp/seasonal-eiken" target="_blank" style="max-width: 1000px; margin: 0 auto 40px; display: block;"> <img src="/assets/img/index_lp/pc_bnr_autumn2025.webp" alt="英検®︎駆け込み歓迎！短期集中講座" class="pc"> <img src="/assets/img/index_lp/sp_bnr_autumn2025.webp" alt="1級〜5級対応 英検合格実績累計 1,000名以上 詳しくはこちら" class="sp"> </a> <a class="seasonalschool_bn" href="https://eslclub.jp/seasonal-school" target="_blank" style="max-width: 1000px; margin: -20px auto 40px; display: block;"> <img src="/assets/img/index_lp/pc_bnr_summer2026.webp" alt="夏は英語を頑張りたい！秋の英検に向けて対策！" class="pc"> <img src="/assets/img/index_lp/sp_bnr_summer2026.webp" alt="夏季講習開講中" class="sp"> </a><section><div class="index_school interview"><ul id="tab_list02" class="tab_list" style="display: none;"><li><a class="tab_list_item02 active" href="#elementary">小学生</a></li><li><a class="tab_list_item02" href="#highschool">中高生</a></li></ul><div class="tab_contents_list"><section id="elementary" class="tab_contents02 story_achievements bg_color active" style="background-color: rgb(248, 248, 248);"><ul class="tab_in_list" style="display: none;"><li class="search_emt_item all" data-group=""><span class="in">全て</span></li><li class="search_emt_item" data-group="emt01"><span class="in">初学者</span></li><li class="search_emt_item" data-group="emt02"><span class="in"><span>プリ</span><span>スクール</span><span>卒業生</span></span></li><li class="search_emt_item" data-group="emt03"><span class="in"><span>英会話</span><span>経験者</span></span></li><li class="search_emt_item" data-group="emt04"><span class="in"><span>帰国子女</span><span>インター</span></span></li></ul><h2 class="title js-ani">ESL clubの実績</h2><div class="tab_emt_in_group"><div class="l_box tab_emt_list_item default" data-group="emt03"> <a href="https://eslclub.jp/blog/grade2-interview-atushi/"><ul class="hash_list"><li>読書大好き</li><li>渋谷校</li></ul><div class="achievements_head"><h3 class="catch"> <span>小学2年からESL clubに入塾。</span><span>簡単な絵本を読むレベルから、</span><span>約1年半努力を積み重ねて、</span><span>小学3年生の終わりに2級に合格するまでに急成長！</span></h3><figure class="image"> <img src="/assets/img/story/performance01_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>杉江篤</span>（すぎえ あつし）さん</p><p class="comment"> 海外の学校に行きたいな。自分の力をためしてみたいから。<br>もう今から行きたいくらい。海外に行って会話したいし生活文化を知りたい！</p></div><figure class="image"> <img src="/assets/img/story/performance01_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div><div class="l_box tab_emt_list_item hide" data-group="emt02"> <a href="https://eslclub.jp/blog/interview-yui"><ul class="hash_list"><li>努力家</li><li>渋谷校</li></ul><div class="achievements_head"><h3 class="catch"> <span>小学3年・準2級レベルから</span><span>ESL clubに入って、</span><span>わずか3週間で英検2級合格！</span><span>小学生で英検1級合格を目指す</span></h3><figure class="image"> <img src="/assets/img/story/performance02_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>上市優伊</span>（かみいちゆい）さん</p><p class="comment"> 将来の夢は英語も話せる水泳選手になりたいです。<br> 水泳を頑張って、水泳選手になりたいけど、英語の勉強も続けて二つの仕事ができるようになりたいと思っています。<br> だから、これからも英語の勉強は続けます。</p></div><figure class="image"> <img src="/assets/img/story/performance02_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div><div class="l_box tab_emt_list_item hide" data-group="emt02"> <a href="https://eslclub.jp/blog/interview-kotaro/"><ul class="hash_list"><li>英語苦手</li><li>渋谷校</li></ul><div class="achievements_head"><h3 class="catch"> <span>2018年に小学5年・3級レベル</span><span>からESL clubに通いはじめ、</span><span>2019年の2月に2級に一発で合格</span></h3><figure class="image"> <img src="/assets/img/story/performance03_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>和田晃太朗</span>（わだこうたろう）さん</p><p class="comment"> 大きい目標（英検合格）と小さい目標（単語テストで満点など）を設定していて、それができたらご褒美を作っているので、大人になったら今度は自分でご褒美を設定して、目標に向けて頑張ると思います。</p></div><figure class="image"> <img src="/assets/img/story/performance03_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div><div class="l_box tab_emt_list_item hide" data-group="emt01"> <a href="https://eslclub.jp/blog/367/"><ul class="hash_list"><li>多読</li><li>留学</li><li>渋谷校</li></ul><div class="achievements_head"><h3 class="catch"> <span>小学4年生でESL clubに入塾。</span><span>当時はABCもあやふやでしたが、</span><span>約2年半の努力の末、</span><span>英検2級合格！</span><span>その後、アメリカの中学校に編入！</span></h3><figure class="image"> <img src="/assets/img/story/performance05_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>高井清太郎</span>（たかいせいたろう）さん</p><p class="comment"> 中学のうちから、現地の生徒に負けずに頑張って勉強するつもりです。そして、高校卒業後はアメリカなどの海外の大学へ進学し、将来はアートや建築の道に進みたいです！</p></div><figure class="image"> <img src="/assets/img/story/performance05_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div><div class="l_box tab_emt_list_item hide" data-group="emt04"> <a href="https://eslclub.jp/blog/interview-misaki"><ul class="hash_list"><li>ライティング苦手</li><li>英語楽しい</li><li>渋谷校</li></ul><div class="achievements_head"><h3 class="catch"> <span>海外から帰国後、読み書きが苦手で英検準2級で壁にぶつかり、</span><span>ESL clubに入塾。</span><span>6年生から通いはじめ、英検2級合格！</span></h3><figure class="image"> <img src="/assets/img/story/performance06_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>村松実咲</span>（むらまつみさき）さん</p><p class="comment"> 英検準1級に合格したら短期留学に挑戦したいです。将来的には、英語ができるだけじゃなくて、英語を使って何かできるようになりたいです！</p></div><figure class="image"> <img src="/assets/img/story/performance06_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div><div class="l_box tab_emt_list_item default" data-group="emt03"> <a href="https://eslclub.jp/blog/interview-otsuka/"><ul class="hash_list"><li>レッスン大好き</li><li>オンライン校</li></ul><div class="achievements_head"><h3 class="catch"> <span>4年間通っていた学童から、</span><span>ESL clubオンライン校へ。</span><span>楽しくマンツーマンレッスンに取り組み、リスニングで満点を達成し、英検4級に合格！</span></h3><figure class="image"> <img src="/assets/img/story/performance07_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>大塚貴咲</span>（おおつかきさ）さん</p><p class="comment"> 体験レッスンがとても楽しくて、先生が気に入りました。できたときにすごく褒めてもらえたのが嬉しかったです。</p></div><figure class="image"> <img src="/assets/img/story/performance07_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div><div class="l_box tab_emt_list_item default" data-group="emt03"> <a href="https://eslclub.jp/blog/interview-soichiro/"><ul class="hash_list"><li>面接対策</li><li>中学受験</li><li>オンライン校</li></ul><div class="achievements_head"><h3 class="catch"> <span>三重県から</span><span>ESL clubオンライン校に入会し、</span><span>半年で英検準2級に合格。</span><span>英語特別入試を利用した</span><span>中学入試では見事、志望中学校の</span><span>選抜コースに合格！</span></h3><figure class="image"> <img src="/assets/img/story/performance13_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>北川創一郎</span>（きたがわそういちろう）さん</p><p class="comment"> 海外でこれからいろいろなことを勉強してみたいです。留学も面白そうなのでやってみたいし、英検はなるべく1級を取りたいですね。高校3年生ぐらいで取れるかな。</p></div><figure class="image"> <img src="/assets/img/story/performance13_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div></div></section><section id="highschool" class="tab_contents02 story_achievements bg_color"><ul class="tab_in_list"><li class="search_hsc_item all active" data-group=""><span class="in">全て</span></li><li class="search_hsc_item" data-group="hsc02"><span class="in">英検合格</span></li><li class="search_hsc_item" data-group="hsc01"><span class="in"><span>成績・</span><span>偏差値UP</span></span></li><li class="search_hsc_item" data-group="hsc03"><span class="in">海外進学</span></li></ul><h2 class="title highschool_title js-ani">ESL clubの実績</h2><div class="tab_in_group"><div class="l_box tab_hsc_list_item" data-group='["hsc01"]'> <a href="https://eslclub.jp/blog/interview-terada/"><ul class="hash_list"><li>英語楽しい</li><li>渋谷校</li></ul><div class="achievements_head"><h3 class="catch"> <span>自分に合った塾に通うため、</span><span>高校2年生からESL clubに入塾。</span><span>その後、TEAPのスコアが</span><span>75点から85点にアップ！</span></h3><figure class="image"> <img src="/assets/img/story/performance08_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>寺田詠美</span>（てらだえいみ）さん</p><p class="comment"> 将来の夢は明確には決まっていませんが、外国語を使う仕事をしたいです。海外で働きたいかどうかはまだ分かりません。でも、興味はあるので、大学生になったら留学をしたいと思っています。</p></div><figure class="image"> <img src="/assets/img/story/performance08_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div><div class="l_box tab_hsc_list_item" data-group='["hsc01","hsc02"]'> <a href="https://eslclub.jp/blog/interview-mizunoya/"><ul class="hash_list"><li>努力家</li><li>オンライン校</li></ul><div class="achievements_head"><h3 class="catch"> <span>中1の春からESL clubに入塾。</span><span>レッスンに積極的に参加し、宿題も欠かさずやることで、ESL club最速の4ヶ月で英検準2級に合格！</span><span>学校の定期試験では学年1位に！</span></h3><figure class="image"> <img src="/assets/img/story/performance09_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>水野谷駿</span>（みずのやしゅん）さん</p><p class="comment"> 将来、アメリカのMIT（マサチューセッツ工科大学）に進学して、最終目標としては発明家を目指したいです！</p></div><figure class="image"> <img src="/assets/img/story/performance09_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div><div class="l_box tab_hsc_list_item" data-group='["hsc03"]'> <a href="https://eslclub.jp/blog/interview_riku/"><ul class="hash_list"><li>短期習得</li><li>講師の存在</li><li>渋谷校</li></ul><div class="achievements_head"><h3 class="catch"> <span>アメリカへ留学するために、</span><span>高校生でESL clubに入塾。</span><span>英検3級レベルからたった3ヶ月で、2級合格レベルを達成するまでに急成長！</span></h3><figure class="image"> <img src="/assets/img/story/performance10_photo.jpg" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>中島陸</span>（なかじまりく）さん</p><p class="comment"> ESL clubで得たものは学習習慣だと思います。自分に合ったレベルの学習を継続することが一番身になると、身を持って感じました！</p></div><figure class="image"> <img src="/assets/img/story/performance10_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div><div class="l_box tab_hsc_list_item" data-group='["hsc02"]'> <a href="https://eslclub.jp/blog/intervire_hr/"><ul class="hash_list"><li>短期合格</li><li>大学受験</li><li>オンライン校</li></ul><div class="achievements_head"><h3 class="catch"> <span>上智大学国際総合グローバル学部を受験するために、高校生でESL clubに入塾。</span><span>たった3ヶ月で、準1級に合格し、</span><span>見事志望校にも入学するまでに急成長！</span></h3><figure class="image"> <img src="/assets/img/story/performance12_photo.jpg?00" alt=""></figure></div><div class="achievements_foot"><div class="profile"><p class="name"><span>R</span>さん</p><p class="comment"> ESL clubは、英検準1級合格にむかってスケジュールや課題の内容を組んでくれるので、それをこなしていくと合格に向かえるという点が心強かったですね。</p></div><figure class="image"> <img src="/assets/img/story/performance12_step.png" alt=""></figure></div> <small class="att"><span>※学習成果は、生徒さま一人ひとりの</span><span>頑張りによって</span><span>個人差があります</span></small> </a></div></div><p class="highschool_btn"><a href="https://eslclub.jp/highschool/"> <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="512" height="359.05" viewBox="0 0 512 359.05"><g transform="translate(0 -76.475)"><path d="M373.366,195.429,256,76.475,138.635,195.429H0v240.1H512v-240.1ZM23.746,219.175H148.56L256,110.285l107.445,108.89H488.254v192.6H281.427v-78.31a25.431,25.431,0,0,0-50.862,0v78.31H23.746Z" fill="#fff"/><rect width="26.45" height="48.822" transform="translate(62.164 314.005)" fill="#fff"/><rect width="26.452" height="48.822" transform="translate(144.672 314.005)" fill="#fff"/><rect width="26.451" height="48.822" transform="translate(340.87 314.005)" fill="#fff"/><rect width="26.452" height="48.822" transform="translate(423.386 314.005)" fill="#fff"/><path d="M256,258.829a49.51,49.51,0,1,0-49.51-49.51A49.519,49.519,0,0,0,256,258.829ZM232.18,185.5a33.684,33.684,0,1,1-9.863,23.823A33.581,33.581,0,0,1,232.18,185.5Z" fill="#fff"/><path d="M275.406,205.362H259.954V186.046h-7.916v27.232h23.368Z" fill="#fff"/></g></svg></span> <span class="tx"><span>中高生はこちら</span></span> </a></p></section></div></div></section><section class="story_dialogue" style="display: none;"><h2 class="title js-ani"><span class="btm_mg">英語教育専門家<small>（イングリッシュカンパニー）</small>も</span><span>認めた「ESL club」</span></h2><div class="l_box"><div class="text_box"><p class="row_text"> ESL clubが提供する英語教育サービスが、第二言語習得理論の観点からも優れていることがわかりました。詳しくは、“言語教育情報学修士” “TOEIC990点” “TESOL（英語教育の国際資格）” を持つ英語教育専門家でもある、株式会社スタディハッカー取締役の田畑氏との対談【<a href="https://kodomo-manabi-labo.net/esl-club-interview-02" target="_blank" rel="noopener">https://kodomo-manabi-labo.net/esl-club-interview-02</a>】をご覧ください。</p></div><figure class="image"> <img src="/assets/img/story/dialogue_photo.jpg" alt=""></figure></div><div class="cta_campaign_wrap"><div class="cta_campaign01 winter"><div class="campaign_text"><p><strong><span class="cl">バイリンガル講師<span>の</span></span><br><span class="cl">個別レッスン<span>が</span>受けられる！</span></strong></p></div></div><div class="cta_wrap"><div class="cta_btn"> <a href="https://eslclub.jp/trial/"> <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="44" height="48" viewBox="0 0 44 48"><g transform="translate(-1160.189 -7421.383)"><path d="M197.219,800.338a3.478,3.478,0,0,1-2.163-.783L176.54,783.528,158,799.555a3.308,3.308,0,0,1-4.679-.4,3.393,3.393,0,0,1,.353-4.723l20.7-17.841a3.225,3.225,0,0,1,4.3,0l20.7,17.841a3.393,3.393,0,0,1,.353,4.723,3.261,3.261,0,0,1-2.516,1.186" transform="translate(1960.528 7268.854) rotate(90)" fill="#fff"></path><path d="M197.219,799.654a3.375,3.375,0,0,1-2.163-.807l-18.516-16-18.539,16a3.265,3.265,0,0,1-4.679-.38,3.4,3.4,0,0,1,.353-4.724l20.7-17.862a3.276,3.276,0,0,1,4.3,0l20.7,17.862a3.394,3.394,0,0,1,.353,4.724,3.259,3.259,0,0,1-2.516,1.187" transform="translate(1979.265 7268.854) rotate(90)" fill="#fff"></path></g></svg></span> <span class="tx"><span></span><span>無料体験レッスンに申し込む</span></span> </a></div></div></div><p class="cta_online_text bubble_add"> <a href="https://eslclub.jp/online/"><span class="icon"><img src="/assets/img/story/i-online.svg" alt=""></span><span class="tx"><strong>オンライン校</strong>はこちら！</span><span class="bubble"><span>継続率<strong>97%</strong></span></span></a></p></section><section class="story_thought bg_color"><div class="l_box"><div class="text_box"><h2 class="title js-ani"><span>世界で活躍できる子を</span><span>育てるために</span></h2><div class="story_thought_text"><p class="row_text"> 「世界で活躍できるための英語力」<br> それは本当に英検やTOEFLといった英語4技能試験のみで測れるのでしょうか？</p><p class="row_text"> ESL clubはそうは考えていません。</p><p class="row_text"> <span>世界で活躍するために、英語4技能試験でも測れる高い英語運用力は</span><span>確かに必要ですが、それだけでは足りません。</span></p><p class="row_text"> では、何が足りないのでしょうか？</p><p class="row_text"> それは、「自分は海外でも活躍できる！」という自信であり、自立心です。</p><p class="row_text"> <span>そういった自立心を培うためには、ESL clubで高めた英語4技能を駆使し、</span> <span>海外の人たちと共に学び、共に過ごす海外体験が必要です。</span></p><p class="row_text"> <span>海外体験を通じて、英語でコミュニケーションをとり、</span><span>多様なバックグランドを持つ人々と過ごす難しさや喜びをリアルに体験する。</span> <span>その結果得られる「自分は英語でもやっていけた！」という自信は、</span><span>生徒たちが見据える将来を「日本国内」から「世界」へと広げていきます。</span></p><p class="row_text"> <span>バイリンガル講師による個別指導で高めた英語4技能と、</span><span>海外体験で得られる自立心を武器に、海外で活躍できる人材を輩出する。</span> <span>それがESL clubです。</span></p></div></div></div></section><section id="plan"><div class="index_school"><ul id="tab_list" class="tab_list"><li><a class="tab_list_item active" href="#shibuya">渋谷校</a></li><li><a class="tab_list_item" href="#online">オンライン校</a></li></ul><div class="tab_contents_list"><div id="shibuya" class="tab_contents active"><section class="index_classroom bg_color"><h3 class="title js-ani">教室紹介</h3><div class="classroom_slider js-slider"><div><img src="/assets/img/index_lp/classroom.jpg?00" alt=""></div></div><div class="classroom_about"><h3 class="name">ESL club 渋谷校</h3><p class="tel"><a href="tel:0337973380">03-3797-3380</a></p><div class="classroom_info"><dl><dt>住所</dt><dd><span>〒150-0002 </span><span>渋谷区渋谷1-8-6 宮益坂STビル10階</span></dd></dl><dl><dt>営業時間</dt><dd><span>火曜日〜金曜日 14：00～20：00 </span><span>(土 14：00～19：00)</span></dd></dl><dl><dt>休校日</dt><dd>月曜日・日曜日<br></dd></dl></div></div></section> <span data-price="shibuya" class="page_price_link"></span><section class="story_price bg_color"><div class="in_box"><h3 class="title js-ani">料金</h3><table class="price_list02"><tr><th></th><th>マンツーマンレッスン</th></tr><tr><th><span>週1回</span><small>（月4回）</small></th><td>58,300円<span>（税込）</span></td></tr><tr><th><span>週2回</span><small>（月8回）</small></th><td>85,800円<span>（税込）</span></td></tr><tr><th><span>週3回</span><small>（月12回）</small></th><td>113,300円<span>（税込）</span></td></tr></table><dl class="admission_fee campaign"><dt>入会金</dt><dd> 22,000円<span>（税込）</span></dd></dl><section class="overview_block"><h4 class="left_title">概要</h4><dl class="overview_list target"><dt>対象</dt><dd> 小学1年生 ～ 高校3年生 <br class="sp_s">（既卒含む）<small>※</small></dd></dl><dl class="overview_list format"><dt>レッスン形式</dt><dd><p class="lesson_type">バイリンガル講師によるマンツーマンレッスン</p></dd></dl><dl class="overview_list time"><dt>レッスン時間</dt><dd>1回90分</dd></dl><ul class="attention_list"><li>※未就学児はご相談ください。</li></ul></section><section class="time_table_block"><h4 class="left_title">タイムテーブル</h4><table class="time_table"><tr><th>火〜金</th><th>土</th><th>月・日</th></tr><tr><td>①14:45〜16:15</td><td>①14:20〜15:50</td><td rowspan="3">お休みです</td></tr><tr><td>②16:30〜18:00</td><td>②16:05〜17:35</td></tr><tr><td>③18:15〜19:45</td><td>③17:50〜19:20</td></tr></table></section></div></section><section class="index_head_teacher"><h3 class="title js-ani">スクールマネジャーより<br class="sp_s">ご挨拶</h3><div class="head_teacher"><div class="head_teacher_comment"><p> 私は、英検は子どもたちの成長を確認するための一つの「通過点」だと考えています。
 もちろん、英検合格は大きな目標です。しかし、私が本当に大切にしたいのは、その過程で身につく英語力や、目標に向かって努力する経験です。</p><p> これまで子どもたちと向き合う中で、結果だけでなく、その過程で得られる経験や自信こそが、その後の成長を支える大切な財産になることを実感してきました。</p><p> 英検の学習を通して、英語力だけでなく、挑戦する力や継続する力も身につけていきます。そして、「できた」という成功体験の積み重ねが、自信となって次の一歩を後押ししてくれます。</p><p> 私は、子どもたちには自分でも気付いていない大きな可能性があると信じています。その可能性を引き出し、一人ひとりが自信を持って成長していけるよう支えていくことが私の役割です。</p><p> 英語を学ぶことが、お子さまの未来の選択肢を広げるきっかけとなるよう、ESL club渋谷校スタッフ一同、全力でサポートしてまいります。みなさまとお会いできることを心より楽しみにしております。</p></div><div class="head_teacher_image"><figure> <img class="sp_pc" src="/assets/img/index_lp/pc_head_teacher2.webp" alt=""> <img class="sp_s" src="/assets/img/index_lp/sp_head_teacher2.webp" alt=""></figure><p> <span class="job">渋谷校　スクールマネジャー</span> <span class="name">杉舘 皆華</span></p></div></div></section><div class="cta_campaign_wrap"><div class="cta_campaign01 winter"><div class="campaign_text"><p><strong><span class="cl">バイリンガル講師<span>の</span></span><br><span class="cl">個別レッスン<span>が</span>受けられる！</span></strong></p></div></div><div class="cta_wrap"><div class="cta_btn"> <a href="https://eslclub.jp/trial/"> <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="44" height="48" viewBox="0 0 44 48"><g transform="translate(-1160.189 -7421.383)"><path d="M197.219,800.338a3.478,3.478,0,0,1-2.163-.783L176.54,783.528,158,799.555a3.308,3.308,0,0,1-4.679-.4,3.393,3.393,0,0,1,.353-4.723l20.7-17.841a3.225,3.225,0,0,1,4.3,0l20.7,17.841a3.393,3.393,0,0,1,.353,4.723,3.261,3.261,0,0,1-2.516,1.186" transform="translate(1960.528 7268.854) rotate(90)" fill="#fff"></path><path d="M197.219,799.654a3.375,3.375,0,0,1-2.163-.807l-18.516-16-18.539,16a3.265,3.265,0,0,1-4.679-.38,3.4,3.4,0,0,1,.353-4.724l20.7-17.862a3.276,3.276,0,0,1,4.3,0l20.7,17.862a3.394,3.394,0,0,1,.353,4.724,3.259,3.259,0,0,1-2.516,1.187" transform="translate(1979.265 7268.854) rotate(90)" fill="#fff"></path></g></svg></span> <span class="tx"><span></span><span>無料体験レッスンに申し込む</span></span> </a></div></div></div><p class="cta_online_text bubble_add"> <a href="https://eslclub.jp/online/"><span class="icon"><img src="/assets/img/story/i-online.svg" alt=""></span><span class="tx"><strong>オンライン校</strong>はこちら！</span><span class="bubble"><span>継続率<strong>97%</strong></span></span></a></p></div><div id="online" class="tab_contents"><section class="index_classroom bg_color"><div class="in_box"><h3 class="title js-ani">教室紹介</h3><div class="classroom_slider js-slider"><div><img src="/assets/img/index_lp/classroom_on.jpg" alt=""></div></div><div class="classroom_about"><h4 class="name">ESL club オンライン校</h4><div class="classroom_info"><dl><dt>営業時間</dt><dd><span>火曜日〜金曜日 14：00～20：00 </span><span>(土 14：00～19：00)</span></dd></dl><dl><dt>休校日</dt><dd>月曜日・日曜日<br></dd></dl></div><p class="row_text"> バイリンガル講師の個別レッスン指導をオンラインでも受講できます。<br> シャドーイングやエッセイライティングの指導といったバイリンガルによる個別指導だからこそのレッスンはもちろん、生徒一人ひとりに合わせた学習プランのご提案まで、教室と全く同じサービスをご提供いたします。</p></div></div></section> <span data-price="online" class="page_price_link"></span><section class="story_price bg_color"><div class="in_box"><h3 class="title js-ani">料金</h3><dl class="price_list"><dt><span>週1回</span><span>（月4回）</span></dt><dd>33,000円<span>（税込）</span></dd><dt><span>週2回</span><small>（月8回）</small></dt><dd>52,800円<span>（税込）</span></dd><dt><span>週3回</span><small>（月12回）</small></dt><dd>79,200円<span>（税込）</span></dd></dl><dl class="admission_fee campaign"><dt>入会金</dt><dd> 22,000円<span>（税込）</span></dd></dl><p class="attention">※教材は別途ご購入いただきます</p><section class="time_table_block double_lesson_block"><h4 class="left_title">週2回のレッスンは、同日に連続で受講することも可能です。</h4><table class="price_list02"><tr><th rowspan="3">受講例</th><td>16:00～16:45</td><td>レッスン①</td></tr><tr><td>16:45～17:00</td><td>休憩</td></tr><tr><td>17:00～17:45</td><td>レッスン②</td></tr></table></section><section class="overview_block"><h4 class="left_title">概要</h4><dl class="overview_list"><dt>対象</dt><dd> 小学1年生 ～ 高校3年生 <br class="sp_s">（既卒含む）<small>※</small></dd></dl><dl class="overview_list"><dt>レッスン形式</dt><dd>バイリンガル講師による<br class="sp_s">完全マンツーマンレッスン</dd></dl><dl class="overview_list"><dt>レッスン時間</dt><dd>1回 45分</dd></dl><ul class="attention_list"><li>※未就学児のお子様はご相談ください。</li></ul></section><section class="time_table_block"><h4 class="left_title">タイムテーブル</h4><table class="time_table"><tr><th>火〜金</th><th>土</th><th>月・日</th></tr><tr><td>－</td><td>①14:00～14:45</td><td rowspan="7">お休みです</td></tr><tr><td>－</td><td>②15:00～15:45</td></tr><tr><td>③16:00～16:45</td><td>③16:00～16:45</td></tr><tr><td>③17:00～17:45</td><td>③17:00～17:45</td></tr><tr><td>⑤18:00～18:45</td><td>⑤18:00～18:45</td></tr><tr><td>⑥19:00～19:45</td><td>－</td></tr><tr><td>⑦20:00～20:45<br><small style="font-size: .8em; margin-top: .2em; display: block;">※火・木のみ</small></td><td>－</td></tr></table></section></div></section><section class="index_head_teacher"><h3 class="title js-ani">スクールマネジャーより<br class="sp_s">ご挨拶</h3><div class="teacher_slider_arw"></div><div class="teacher_slider"><div class="head_teacher"><div class="head_teacher_comment"><p> みなさんにとっての、『英語』って何でしょうか？<br> 私にとっての『英語』とは、子どもたちの世界や視野を広げてくれるツールだと思います。<br> 将来の進路や、夢・目標を叶えられる場所や可能性がグーンと増やせるからです。</p><p> 英語は、子どもたちと世界の架け橋となり、とにかく新しい気づきを与え続けてくれます。<br> 例えば、文化の違い、見たこともない景色、日本では会えない人との出会い…。<br> この気づきは子どもたちにとって、「違うって面白い」「もっと知りたい」という探求の原動力になります。</p><p> こうした探求の原動力を刺激し引き出しながら、子どもたちの可能性を英語で広げ、わくわくする気持ちを育んであげたい。</p><p> そのためにもオンライン校では、楽しく、着実に実力に繋がるよう、一人ひとりの得意・不得意に柔軟に、カリキュラムを組みレッスンを行っています。<br> まずは土台となる、一生モノの英語力を身に付けて、世界を広げる準備を一緒に始めませんか？</p><p> みなさんと、英語とどんな将来を描いているのか、お話しできる日を楽しみにしています。</p></div><div class="head_teacher_image"><figure> <img class="sp_pc" src="/assets/img/index_lp/pc_head_teacher_on.jpg" alt=""> <img class="sp_s" src="/assets/img/index_lp/sp_head_teacher_on.jpg" alt=""></figure><p> <span class="job">オンライン校 スクールマネジャー</span> <span class="name">梶 玲菜</span></p></div></div><div class="head_teacher"><div class="head_teacher_comment"><p> 英語は、何のために身につけるものか、人それぞれで、どれも正解だと思います。<br> ただ、その中で、何か一つ楽しい理由を持って欲しいと思っております。</p><p> 洋画を、吹き替え・字幕なしで見たい。<br> 海外のYouTuberを、翻訳されるのを待たないで見れるようになりたい。<br> 将来外車を買うときに、マニュアルが全部英語でもへっちゃらになりたい。</p><p> 英語の習得は、時には難しく、辛いときもあるでしょう。<br> でもその先に、趣味的な意味でも楽しい未来が待っていて欲しい。<br> 英語は、勉強として身につけるのだけではなく、自分の人生を楽しくするためにも身につけて欲しい。<br> そして、ゴールだけでなく、その過程も楽しくしてあげたい、というのが私の願いです。</p><p> 是非、私やESL club の講師と接してみて、英語ができたら、なにが楽しいんだろう？と問いかけてみてください。<br> 多種多様な答えが返ってきますので、これだ！と思えるもの見つけ出すのも、英語学習の一環としてみてはいかがでしょうか。</p></div><div class="head_teacher_image"><figure> <img class="sp_pc" src="/assets/img/index_lp/pc_head_teacher_on02.jpg" alt=""> <img class="sp_s" src="/assets/img/index_lp/sp_head_teacher_on02.jpg" alt=""></figure><p> <span class="job">オンライン校 スクールマネジャー</span> <span class="name">楠山 理紀</span></p></div></div></div></section><div class="cta_campaign_wrap"><div class="cta_campaign01 winter"><div class="campaign_text"><p><strong><span class="cl">バイリンガル講師<span>の</span></span><br><span class="cl">個別レッスン<span>が</span>受けられる！</span></strong></p></div></div><div class="cta_wrap"><div class="cta_btn"> <a href="https://eslclub.jp/trial/"> <span class="icon"><svg xmlns="http://www.w3.org/2000/svg" width="44" height="48" viewBox="0 0 44 48"><g transform="translate(-1160.189 -7421.383)"><path d="M197.219,800.338a3.478,3.478,0,0,1-2.163-.783L176.54,783.528,158,799.555a3.308,3.308,0,0,1-4.679-.4,3.393,3.393,0,0,1,.353-4.723l20.7-17.841a3.225,3.225,0,0,1,4.3,0l20.7,17.841a3.393,3.393,0,0,1,.353,4.723,3.261,3.261,0,0,1-2.516,1.186" transform="translate(1960.528 7268.854) rotate(90)" fill="#fff"></path><path d="M197.219,799.654a3.375,3.375,0,0,1-2.163-.807l-18.516-16-18.539,16a3.265,3.265,0,0,1-4.679-.38,3.4,3.4,0,0,1,.353-4.724l20.7-17.862a3.276,3.276,0,0,1,4.3,0l20.7,17.862a3.394,3.394,0,0,1,.353,4.724,3.259,3.259,0,0,1-2.516,1.187" transform="translate(1979.265 7268.854) rotate(90)" fill="#fff"></path></g></svg></span> <span class="tx"><span></span><span>無料体験レッスンに申し込む</span></span> </a></div></div></div><p class="cta_online_text bubble_add"> <a href="https://eslclub.jp/online/"><span class="icon"><img src="/assets/img/story/i-online.svg" alt=""></span><span class="tx"><strong>オンライン校</strong>はこちら！</span><span class="bubble"><span>継続率<strong>97%</strong></span></span></a></p></div></div></div></section></article><style>.cta_bnr{text-align:center}.cta_bnr img{width:100%;max-width:768px;height:auto;margin-top:60px}@media (max-width:749px){.cta_bnr img{margin-top:30px}}.story_price.bg_color h3.title{padding-top:0}</style> <script>var _CIDN = "cid";
